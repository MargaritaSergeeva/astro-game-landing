{
  "name": "twilighthaven-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "dev:refresh": "ASTRO_TELEMETRY_DISABLED=1 astro dev stop && ASTRO_TELEMETRY_DISABLED=1 astro dev --force",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.{css,astro}\" --cache --cache-location .cache/stylelint",
    "lint:css:fix": "stylelint \"src/**/*.{css,astro}\" --fix --cache --cache-location .cache/stylelint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "prettier --check . && eslint . && stylelint \"src/**/*.{css,astro}\" --cache --cache-location .cache/stylelint && astro check"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "yarn@4.17.0",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.2.8",
    "astro": "^7.0.6",
    "swiper": "^14.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^2.1.1",
    "globals": "^17.7.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.14.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}
