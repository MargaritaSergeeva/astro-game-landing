---
import { defaultLocale, localeStorageKey, supportedLocales } from '../i18n/config';
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0f0f0f" />
    <title>TWILIGHTHAVEN</title>
    <script
      is:inline
      define:vars={{
        defaultLocale,
        localeStorageKey,
        supportedLocales,
      }}
    >
      (() => {
        let locale = defaultLocale;

        try {
          const savedLocale = window.localStorage.getItem(localeStorageKey);
          if (supportedLocales.includes(savedLocale)) {
            locale = savedLocale;
          }
        } catch {
          locale = defaultLocale;
        }

        window.location.replace(`/${locale}/${window.location.search}${window.location.hash}`);
      })();
    </script>
  </head>
  <body>
    <noscript>
      <a href={`/${defaultLocale}/`}>Open TWILIGHTHAVEN</a>
    </noscript>
  </body>
</html>
