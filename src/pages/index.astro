---
import { defaultLocale } from '../i18n/config';
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0f0f0f" />
    <title>TWILIGHTHAVEN</title>
    <script is:inline define:vars={{ defaultLocale }}>
      window.location.replace(`/${defaultLocale}/${window.location.search}${window.location.hash}`);
    </script>
  </head>
  <body>
    <noscript>
      <a href={`/${defaultLocale}/`}>Open TWILIGHTHAVEN</a>
    </noscript>
  </body>
</html>
