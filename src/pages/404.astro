---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  locale="en"
  title="Page not found — TWILIGHTHAVEN"
  description="The requested TWILIGHTHAVEN page could not be found."
  noindex
>
  <main class="not-found">
    <p>404</p>
    <h1>Page not found</h1>
    <a href="/en/">Return to TWILIGHTHAVEN</a>
  </main>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: 24px;
    place-content: center;
    min-height: 100dvh;
    padding: 32px;
    text-align: center;
  }

  .not-found p {
    font-size: 24px;
    color: var(--color-accent);
  }

  .not-found h1 {
    font-family: var(--font-display);
    font-size: clamp(48px, 8vw, 90px);
  }

  .not-found a {
    justify-self: center;
    padding: 14px 24px;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-control);
  }
</style>
