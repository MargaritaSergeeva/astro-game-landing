---
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { supportedLocales, type Locale } from '../../i18n/config';
import { getTranslations } from '../../i18n/loader';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return supportedLocales.map((locale) => ({
    params: { lang: locale },
    props: { locale },
  }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translation = getTranslations(locale);
---

<BaseLayout locale={locale} title={translation.seo.title} description={translation.seo.description}>
  <main id="home">
    <p>{translation.home.eyebrow}</p>
    <h1>{translation.home.title}</h1>
    <LanguageSwitcher
      currentLocale={locale}
      label={translation.common.languageSwitcherLabel}
      currentSection="home"
    />
  </main>
</BaseLayout>
