---
import contactWord from '../assets/icons/contact.svg';
import { siteConfig } from '../config/site';
import type { Translations } from '../i18n/loader';
import SectionMarker from './SectionMarker.astro';
import SocialLinks from './SocialLinks.astro';

interface Props {
  translation: Translations;
}

const { translation } = Astro.props;
---

<section
  class="contact-section swiper-slide"
  id="contacts"
  data-section="contacts"
  aria-labelledby="contact-title"
>
  <div class="contact-section__inner container">
    <SectionMarker index={translation.contact.index} title={translation.navigation.contact} />
    <h2 class="sr-only" id="contact-title">{translation.contact.title}</h2>

    <a class="contact-section__studio-email" href={`mailto:${siteConfig.studioEmail}`}>
      {siteConfig.studioEmail}
    </a>

    <div class="contact-section__details">
      <div class="contact-section__ceo">
        <span>{translation.contact.ceoLabel}</span>
        <a href={`mailto:${siteConfig.ceoEmail}`}>{siteConfig.ceoEmail}</a>
      </div>

      <div class="contact-section__copy">
        {translation.contact.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <footer class="contact-section__footer">
      <SocialLinks class="contact-section__socials" />
      <p class="contact-section__copyright">© 2026 TWILIGHTHAVEN</p>
      <img class="contact-section__word" src={contactWord.src} alt="" aria-hidden="true" />
    </footer>
  </div>
</section>

<style>
  .contact-section {
    min-height: 100dvh;
    padding-block: 140px 0;
    overflow: hidden auto;
    scroll-margin-top: 84px;
  }

  .contact-section__inner {
    position: relative;
    min-height: calc(100dvh - 140px);
  }

  .contact-section__studio-email {
    display: block;
    margin-top: 64px;
    font-size: clamp(64px, 6.7vw, var(--type-contact-email-size));
    font-weight: var(--font-weight-medium);
    line-height: 1.06;
    color: var(--color-accent);
    overflow-wrap: anywhere;
  }

  .contact-section__details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-top: 88px;
  }

  .contact-section__ceo {
    display: grid;
    gap: 22px;
    align-content: start;
  }

  .contact-section__ceo span,
  .contact-section__copy {
    font-size: clamp(18px, 1.25vw, 24px);
    line-height: 1.35;
    color: var(--color-text-muted);
  }

  .contact-section__ceo a {
    font-size: clamp(20px, 1.45vw, 28px);
    line-height: 1.35;
  }

  .contact-section__copy {
    display: grid;
    gap: 28px;
  }

  .contact-section__copy p:nth-child(2) {
    color: var(--color-text);
  }

  .contact-section__copyright {
    display: none;
  }

  .contact-section__word {
    position: absolute;
    right: 0;
    bottom: -84px;
    left: 0;
    width: 100%;
    height: auto;
    pointer-events: none;
    opacity: 0.9;
  }

  @media (width <= 767px) {
    .contact-section {
      min-height: 0;
      padding-block: 24px 0;
      overflow: hidden;
    }

    .contact-section__inner {
      min-height: 0;
      padding-bottom: 132px;
    }

    .contact-section__studio-email {
      margin-top: 0;
      font-size: 24px;
      line-height: 32px;
    }

    .contact-section__details {
      display: flex;
      flex-direction: column;
      gap: 36px;
      margin-top: 34px;
    }

    .contact-section__ceo {
      gap: 10px;
    }

    .contact-section__ceo span,
    .contact-section__copy {
      font-size: 14px;
      line-height: 20px;
    }

    .contact-section__ceo a {
      font-size: 20px;
      line-height: 28px;
    }

    .contact-section__copy {
      gap: 24px;
    }

    .contact-section__copy p:nth-child(2) {
      color: var(--color-text-muted);
    }

    .contact-section__copyright {
      position: relative;
      z-index: 2;
      display: block;
      margin-top: 36px;
      font-size: 16px;
      line-height: 24px;
      color: var(--color-text-muted);
      text-align: center;
    }

    .contact-section__word {
      right: auto;
      bottom: -22px;
      left: 50%;
      width: 540px;
      max-width: none;
      transform: translateX(-50%);
    }
  }
</style>
