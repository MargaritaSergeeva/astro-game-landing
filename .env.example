# Required for canonical URLs, hreflang, Open Graph, robots.txt, and sitemap.
# Set a different SITE_URL in GitLab CI/CD variables for each deploy environment/job:
# - development/staging: test domain
# - main/production: production domain
SITE_URL=https://your-domain.example

# Set to true for test/staging deploys to prevent search engine indexing.
# Leave false or unset for production.
SITE_NOINDEX=false
